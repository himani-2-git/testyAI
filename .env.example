# Copy this file to .env and fill in the values. Never commit .env.
# The server checks these at startup and refuses to start if one is wrong.

# ── LLM providers ──
# "auto" = use the real providers below in fallback order (default).
# "mock" = fake questions, no API key needed (tests / offline work). Refused in production.
LLM_PROVIDER=auto
# At least one of GROQ_API_KEY / CEREBRAS_API_KEY is required when LLM_PROVIDER=auto.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=optional_secondary_groq_api_key
CEREBRAS_API_KEY=optional_cerebras_api_key

# ── Firebase Admin SDK (required) ──
# The service-account JSON file, base64-encoded onto one line.
# Create it in PowerShell without printing the key:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json")) | Set-Clipboard
# then paste after the "=" below. Delete the downloaded JSON file afterwards.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Limits ──
# Generations each signed-in user may run per UTC day (default 30).
DAILY_GENERATION_QUOTA=30

# ── Web ──
# Comma-separated websites allowed to call /api from a browser.
# Default: http://localhost:<PORT>. Required in production, e.g. https://testyai.onrender.com
ALLOWED_ORIGINS=http://localhost:8080
PORT=8080
# Set NODE_ENV=production on Render (enables the production checks above).
# NODE_ENV=production
